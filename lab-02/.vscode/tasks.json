{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Java",
            "type": "shell",
            "command": "javac -encoding UTF-8 -cp \"lib/*;bin\" -d bin (Get-ChildItem -Path src -Filter *.java -Recurse).FullName",
            "windows": {
                "command": "javac -encoding UTF-8 -cp \"lib/*;bin\" -d bin (Get-ChildItem -Path src -Filter *.java -Recurse).FullName"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$javac"]
        },
        {
            "label": "Run Java (MqttExample)",
            "type": "shell",
            "command": "java -Dfile.encoding=UTF-8 -cp \"lib/*;bin\" MqttExample",
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "dependsOn": "Build Java"
        },
        {
            "label": "Run Java (Main)",
            "type": "shell",
            "command": "java -Dfile.encoding=UTF-8 -cp \"lib/*;bin\" Main",
            "dependsOn": "Build Java"
        }
    ]
}
